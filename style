@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');


/* ================= VARIABLES ================= */

:root {

    --background: #080b12;
    --background-light: #0d111a;

    --card: #111722;
    --card-light: #151c29;

    --border: #252e3d;

    --text: #f5f7fb;
    --muted: #9ca7b8;

    --purple: #7c5cff;
    --purple-light: #9b83ff;

    --green: #25d366;

}


/* ================= RESET ================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {

    margin: 0;

    background: var(--background);

    color: var(--text);

    font-family:
        Inter,
        Arial,
        sans-serif;

    line-height: 1.5;

}

a {
    text-decoration: none;
    color: inherit;
}

button,
input,
textarea,
select {
    font-family: inherit;
}


/* ================= GENERAL ================= */

.container {

    width: min(1160px, 92%);

    margin: auto;

}

section {
    padding: 90px 0;
}

.eyebrow {

    color: var(--purple-light);

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 1.7px;

}

.section-header h2 {

    font-size: 38px;

    margin:
        7px
        0
        0;

    letter-spacing: -1.5px;

}

.section-header.center {

    text-align: center;

}

.section-header.center p {

    color: var(--muted);

}


/* ================= BUTTONS ================= */

.button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    padding:
        13px
        20px;

    border-radius: 12px;

    border: none;

    font-weight: 700;

    cursor: pointer;

    transition: .2s;

}

.button.primary {

    background: var(--purple);

    color: white;

    box-shadow:
        0 8px 30px
        rgba(124, 92, 255, .2);

}

.button.primary:hover {

    transform: translateY(-2px);

    background: #8b70ff;

}

.button.secondary {

    background:
        rgba(255,255,255,.03);

    border:
        1px solid var(--border);

}


/* ================= HEADER ================= */

.header {

    position: sticky;

    top: 0;

    z-index: 50;

    background:
        rgba(8,11,18,.84);

    backdrop-filter:
        blur(18px);

    border-bottom:
        1px solid
        rgba(255,255,255,.06);

}

.nav {

    height: 76px;

    display: flex;

    align-items: center;

    gap: 28px;

}

.logo {

    font-size: 21px;

    font-weight: 800;

    letter-spacing: -.7px;

}

.logo span {

    color: var(--purple-light);

}

.desktop-menu {

    display: flex;

    gap: 25px;

    margin-left: auto;

}

.desktop-menu a {

    color: #bdc6d4;

    font-size: 14px;

}

.desktop-menu a:hover {

    color: white;

}

.cart-button {

    border:
        1px solid
        var(--border);

    background:
        var(--card);

    color: white;

    border-radius: 12px;

    padding:
        10px
        13px;

    cursor: pointer;

}

.cart-button b {

    background:
        var(--purple);

    border-radius: 100px;

    padding:
        2px
        7px;

    font-size: 11px;

    margin-left: 5px;

}

.mobile-menu-button {

    display: none;

    background:
        var(--card);

    border:
        1px solid
        var(--border);

    color: white;

    border-radius: 10px;

    padding: 10px;

    cursor: pointer;

}

.mobile-menu {

    display: none;

}


/* ================= HERO ================= */

.hero {

    min-height: 680px;

    display: flex;

    align-items: center;

    position: relative;

    overflow: hidden;

}

.hero-background {

    position: absolute;

    inset: 0;

    background:

        radial-gradient(
            circle at 70% 40%,
            rgba(124,92,255,.25),
            transparent 32%
        ),

        radial-gradient(
            circle at 20% 20%,
            rgba(50,120,255,.10),
            transparent 30%
        ),

        linear-gradient(
            135deg,
            #080b12,
            #0c101b
        );

}

.hero-background::after {

    content: "";

    position: absolute;

    width: 500px;

    height: 500px;

    border:
        1px solid
        rgba(124,92,255,.13);

    border-radius: 50%;

    right: 5%;

    top: 15%;

    box-shadow:
        0 0 100px
        rgba(124,92,255,.08);

}

.hero-content {

    position: relative;

    z-index: 2;

}

.badge {

    display: inline-flex;

    padding:
        8px
        13px;

    border:
        1px solid
        rgba(124,92,255,.3);

    background:
        rgba(124,92,255,.08);

    border-radius: 999px;

    color:
        #b8aaff;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 1px;

}

.hero h1 {

    font-size:
        clamp(
            45px,
            7vw,
            78px
        );

    line-height: 1.02;

    letter-spacing: -3.5px;

    max-width: 850px;

    margin:
        20px
        0;

}

.hero h1 span {

    display: block;

    color:
        var(--purple-light);

}

.hero p {

    max-width: 610px;

    color:
        var(--muted);

    font-size: 18px;

}

.hero-buttons {

    display: flex;

    gap: 12px;

    margin:
        30px
        0;

}

.trust {

    display: flex;

    gap: 28px;

    flex-wrap: wrap;

}

.trust div {

    display: flex;

    align-items: center;

    gap: 8px;

    color:
        #aeb7c6;

    font-size: 13px;

}

.trust strong {

    font-size: 18px;

}


/* ================= CATEGORIES ================= */

.category-grid {

    display: grid;

    grid-template-columns:
        repeat(6, 1fr);

    gap: 12px;

}

.category-grid button {

    background:
        var(--card);

    border:
        1px solid
        var(--border);

    color: white;

    border-radius: 15px;

    padding:
        23px
        10px;

    cursor: pointer;

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 8px;

    font-weight: 700;

    transition: .2s;

}

.category-grid button:hover {

    transform:
        translateY(-3px);

    border-color:
        #5147a0;

}


/* ================= PRODUCTS ================= */

.products-section {

    background:
        var(--background-light);

}

.products-header {

    display: flex;

    justify-content: space-between;

    align-items: end;

    gap: 25px;

    margin-bottom: 30px;

}

.filters {

    display: flex;

    gap: 10px;

}

.filters input,
.filters select {

    background:
        var(--card);

    border:
        1px solid
        var(--border);

    color: white;

    border-radius: 11px;

    padding:
        12px
        14px;

    outline: none;

}

.filters input {

    width: 230px;

}

.filters select {

    width: 190px;

}

.product-grid {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 16px;

}

.product {

    background:
        var(--card);

    border:
        1px solid
        var(--border);

    border-radius: 16px;

    overflow: hidden;

    transition: .2s;

}

.product:hover {

    transform:
        translateY(-4px);

    border-color:
        #3b4659;

}

.product-image {

    height: 165px;

    display: grid;

    place-items: center;

    font-size: 60px;

    background:
        linear-gradient(
            135deg,
            #171e2c,
            #0e1320
        );

}

.product-body {

    padding: 18px;

}

.product-category {

    color:
        var(--purple-light);

    font-size: 10px;

    font-weight: 800;

    text-transform: uppercase;

}

.product h3 {

    margin:
        5px
        0;

    font-size: 17px;

}

.product-description {

    color:
        var(--muted);

    font-size: 12px;

    min-height: 38px;

}

.product-price {

    font-size: 21px;

    font-weight: 800;

    margin-top: 10px;

}

.product .button {

    width: 100%;

    margin-top: 15px;

    padding:
        10px;

}

.empty {

    grid-column: 1 / -1;

    text-align: center;

    padding: 60px;

    color:
        var(--muted);

}


/* ================= HOW ================= */

.how-section {

    background:
        linear-gradient(
            180deg,
            #0b0f17,
            #080b12
        );

}

.steps {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 18px;

    margin-top: 35px;

}

.step {

    position: relative;

    background:
        var(--card);

    border:
        1px solid
        var(--border);

    border-radius: 16px;

    padding: 28px;

}

.step-number {

    position: absolute;

    right: 20px;

    top: 18px;

    color:
        #3d4656;

    font-weight: 800;

}

.step-icon {

    font-size: 32px;

}

.step h3 {

    margin:
        14px
        0
        5px;

}

.step p {

    color:
        var(--muted);

    margin: 0;

}

.notice {

    margin-top: 20px;

    padding:
        15px
        18px;

    border-radius: 12px;

    background:
        rgba(124,92,255,.07);

    border:
        1px solid
        rgba(124,92,255,.2);

    color:
        #cdd3df;

    font-size: 13px;

}


/* ================= WHY ================= */

.why-section {

    background:
        #101520;

}

.why-grid {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 80px;

    align-items: center;

}

.why-section h2 {

    font-size: 48px;

    line-height: 1.05;

    letter-spacing: -2px;

}

.why-section h2 span {

    color:
        var(--purple-light);

}

.why-section p {

    color:
        var(--muted);

}

.features {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 12px;

}

.features article {

    display: flex;

    gap: 14px;

    padding: 20px;

    background:
        #0c111a;

    border:
        1px solid
        var(--border);

    border-radius: 14px;

}

.feature-icon {

    font-size: 25px;

}

.features h3 {

    margin: 0;

}

.features p {

    font-size: 12px;

    margin:
        4px
        0
        0;

}


/* ================= FAQ ================= */

.faq-section {

    background:
        var(--background);

}

.faq-container {

    max-width: 820px;

}

.faq-section details {

    border-bottom:
        1px solid
        var(--border);

    padding:
        20px
        0;

}

.faq-section summary {

    cursor: pointer;

    font-weight: 700;

}

.faq-section details p {

    color:
        var(--muted);

    font-size: 14px;

}


/* ================= CONTACT ================= */

.contact-section {

    background:
        #0f141e;

}

.contact-grid {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 70px;

}

.contact-grid h2 {

    font-size: 42px;

    margin:
        8px
        0;

}

.contact-grid p {

    color:
        var(--muted);

    margin-bottom: 25px;

}

.contact-grid form {

    display: flex;

    flex-direction: column;

    gap: 12px;

}

.contact-grid input,
.contact-grid textarea {

    background:
        var(--card);

    border:
        1px solid
        var(--border);

    color: white;

    border-radius: 11px;

    padding:
        13px
        14px;

    outline: none;

    resize: vertical;

}


/* ================= FOOTER ================= */

.footer {

    background:
        #070a10;

    border-top:
        1px solid
        var(--border);

    padding:
        55px
        0
        20px;

}

.footer-grid {

    display: grid;

    grid-template-columns:
        2fr 1fr 1fr;

    gap: 40px;

}

.footer p,
.footer a {

    color:
        var(--muted);

    font-size: 13px;

}

.footer a {

    display: block;

    margin:
        8px
        0;

}

.footer h4 {

    margin-top: 0;

}

.copyright {

    border-top:
        1px solid
        var(--border);

    margin-top: 40px;

    padding-top: 18px;

    color:
        #657082;

    font-size: 11px;

}


/* ================= WHATSAPP ================= */

.whatsapp {

    position: fixed;

    right: 20px;

    bottom: 20px;

    width: 55px;

    height: 55px;

    border-radius: 50%;

    background:
        var(--green);

    display: grid;

    place-items: center;

    font-size: 25px;

    z-index: 40;

    box-shadow:
        0 10px 30px
        rgba(0,0,0,.35);

}


/* ================= CART ================= */

.cart-overlay {

    display: none;

    position: fixed;

    inset: 0;

    background:
        rgba(0,0,0,.68);

    z-index: 100;

}

.cart-overlay.open {

    display: block;

}

.cart {

    position: absolute;

    right: 0;

    top: 0;

    height: 100%;

    width:
        min(
            430px,
            100%
        );

    background:
        #0d121b;

    border-left:
        1px solid
        var(--border);

    padding: 22px;

    display: flex;

    flex-direction: column;

}

.cart-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

}

.cart-header button {

    background: none;

    border: none;

    color: white;

    font-size: 22px;

    cursor: pointer;

}

.cart-items {

    overflow-y: auto;

}

.cart-item {

    display: flex;

    justify-content: space-between;

    gap: 15px;

    padding:
        16px
        0;

    border-bottom:
        1px solid
        var(--border);

}

.cart-item small {

    color:
        var(--muted);

}

.remove-item {

    background: none;

    border: none;

    color:
        #ff7784;

    cursor: pointer;

}

.cart-footer {

    margin-top: auto;

    border-top:
        1px solid
        var(--border);

    padding-top: 18px;

}

.cart-total {

    display: flex;

    justify-content: space-between;

    font-size: 20px;

    margin-bottom: 15px;

}

.full {

    width: 100%;

}

.cart-footer small {

    display: block;

    color:
        #687386;

    margin-top: 10px;

    font-size: 11px;

}


/* ================= MOBILE ================= */

@media (max-width: 900px) {

    .desktop-menu {

        display: none;

    }

    .mobile-menu-button {

        display: block;

    }

    .mobile-menu {

        padding:
            15px 4%;

        background:
            #0c1018;

        border-top:
            1px solid
            var(--border);

    }

    .mobile-menu.open {

        display: flex;

        flex-direction: column;

        gap: 15px;

    }

    .category-grid {

        grid-template-columns:
            repeat(3, 1fr);

    }

    .product-grid {

        grid-template-columns:
            repeat(2, 1fr);

    }

    .products-header {

        align-items: flex-start;

        flex-direction: column;

    }

    .why-grid,
    .contact-grid {

        grid-template-columns:
            1fr;

        gap: 40px;

    }

    .steps {

        grid-template-columns:
            1fr;

    }

}


@media (max-width: 560px) {

    section {

        padding:
            65px
            0;

    }

    .hero {

        min-height: 620px;

    }

    .hero h1 {

        font-size: 48px;

        letter-spacing:
            -2.5px;

    }

    .hero p {

        font-size: 15px;

    }

    .hero-buttons {

        flex-direction: column;

    }

    .category-grid {

        grid-template-columns:
            repeat(2, 1fr);

    }

    .product-grid {

        grid-template-columns:
            1fr;

    }

    .filters {

        width: 100%;

        flex-direction: column;

    }

    .filters input,
    .filters select {

        width: 100%;

    }

    .features {

        grid-template-columns:
            1fr;

    }

    .footer-grid {

        grid-template-columns:
            1fr;

    }

    .why-section h2,
    .contact-grid h2 {

        font-size: 36px;

    }

    .cart-button span {

        display: none;

    }

}
