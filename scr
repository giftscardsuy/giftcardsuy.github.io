        document
            .getElementById(
                "contact-message"
            )
            .value;


    const whatsappMessage =

        `Hola, soy ${name}.

Mi email: ${email}

Consulta:

${message}`;


    const url =

        "https://wa.me/" +
        WHATSAPP_NUMBER +
        "?text=" +
        encodeURIComponent(
            whatsappMessage
        );


    window.open(
        url,
        "_blank"
    );

}


